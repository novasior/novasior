# ============================================================================
# NOVASIOR PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# Never commit .env to GitHub - it's already in .gitignore
# ============================================================================

# ============================================================================
# 1. RAZORPAY - Payment Gateway
# ============================================================================
# Get these from: https://dashboard.razorpay.com/app/settings/api-keys
# TEST MODE: rzp_test_* (for testing)
# LIVE MODE: rzp_live_* (for real payments)
# Simply swap the keys in Vercel to switch modes - NO CODE CHANGES NEEDED

RAZORPAY_KEY_ID=rzp_test_TOxqYXONJkSgP4
RAZORPAY_KEY_SECRET=crXbn54XHZvzNIUSEQYFRVON

# ============================================================================
# 2. SUPABASE - Database & File Storage
# ============================================================================
# Get these from: https://app.supabase.com/ → Settings → API
# URL: Project Settings → API → URL
# ANON_KEY: Project Settings → API → anon (public) key
# SERVICE_ROLE_KEY: Project Settings → API → service_role (secret) key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# 3. MAKE.COM - Webhook Automation
# ============================================================================
# Webhook URL and API Key for triggering digital product delivery
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/lhkqc4gskv1u2omo5r8wafv5ne1y1jej
MAKE_WEBHOOK_API_KEY=your_make_webhook_api_key

# ============================================================================
# 4. RESEND - Email Delivery (Optional Backup)
# ============================================================================
# Get API key from: https://resend.com/api-keys
# Domain verification: https://resend.com/domains
# EMAIL_FROM: Your verified domain email (e.g., hello@yourdomain.com)
# SUPPORT_EMAIL: Support reply-to email (optional)

RESEND_API_KEY=re_1234567890abcdefghijklmnop
EMAIL_FROM=hello@novasior.com
SUPPORT_EMAIL=support@novasior.com

# ============================================================================
# 5. APP CONFIGURATION
# ============================================================================
# APP_URL: Your production website URL (used in emails for links)
# PORT: Server port (default: 3000, Vercel will set this automatically)
# NODE_ENV: Set automatically by Vercel (development/production)

APP_URL=https://novasior.com
PORT=3000
NODE_ENV=production

# ============================================================================
# VERCEL DEPLOYMENT GUIDE
# ============================================================================
# 
# 1. Connect your GitHub repo to Vercel
# 2. Go to Vercel Dashboard → Settings → Environment Variables
# 3. Add ALL the variables above
# 4. Click "Deploy" - the system will automatically:
#    - Detect Razorpay keys and load them
#    - Connect to Supabase for order storage
#    - Configure Resend for email delivery
#    - Everything works seamlessly!
#
# SWITCHING FROM TEST TO LIVE:
# - Just update RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in Vercel
# - Redeploy
# - That's it! No code changes needed.
#
# ============================================================================

